# Copier ce fichier vers .env.local pour la configuration locale

# === CONFIGURATION D'AUTHENTIFICATION ===

# Pour bypasser l'authentification et utiliser les services mock
VITE_ENABLE_VERIFICATION=false

# Pour utiliser l'authentification normale (si vous avez une vraie API)
# VITE_ENABLE_VERIFICATION=true

# === CONFIGURATION D'ENVIRONNEMENT ===
VITE_APP_ENV=development

# === API CONFIGURATION ===
VITE_API_URL=http://localhost:3000/api
VITE_API_BASE_URL=https://restcountries.com/v3.1/region/africa

# === APP INFO ===
VITE_APP_NAME=EEBTP Stock Management
VITE_APP_VERSION=1.0.0

# === EXPLICATIONS ===
# 
# VITE_ENABLE_VERIFICATION contrôle deux aspects :
# 
# 1. false : Mode développement avec services mock
#    - Affiche les pages d'authentification avec services mock
#    - Utilise mockService.ts avec mot de passe par défaut (123456)
#    - Création automatique d'utilisateurs
#    - OU bypass complet de l'authentification (utilisateur de test automatique)
#
# 2. true : Mode production avec vraie API
#    - Utilise les vraies APIs d'authentification
#    - Nécessite un backend fonctionnel
#
# VITE_APP_ENV=development : Assure l'utilisation des services mock
# même si VITE_ENABLE_VERIFICATION=true (double sécurité)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=