# Variables d'environnement pour le développement

# URL de l'API backend - Utilise le proxy Vite pour éviter CORS
VITE_API_URL=http://localhost:5173/api

# Mode de développement
VITE_APP_ENV=development

# Authentification Basic (temporaire)
VITE_API_USERNAME=your_username
VITE_API_PASSWORD=your_password

# Configuration Auth
VITE_USE_JWT_AUTH=true
VITE_ENABLE_VERIFICATION=false

# Autres configurations
VITE_APP_NAME=EEBTP Stock Management
VITE_APP_VERSION=1.0.0

VITE_API_BASE_URL=https://restcountries.com/v3.1/region/africa